{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "marketing"],
      "port": 8765
    },
    {
      "name": "site-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "marketing/site-v2", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "site-v2-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd marketing/site-v2 && npx wrangler dev --port 8787 --ip 127.0.0.1"],
      "port": 8787
    }
  ]
}
