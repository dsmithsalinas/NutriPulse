// Debug build settings.
// Secrets.xcconfig (gitignored) must exist alongside this file with your Supabase credentials.
#include "Secrets.xcconfig"

// Build number. The real value lives in BuildNumber.xcconfig (gitignored), regenerated by
// scripts/set-build-number.sh from the git commit count. The literal below is only a fallback
// for a fresh clone that hasn't run the script yet; the optional include overrides it.
CURRENT_PROJECT_VERSION = 1
#include? "BuildNumber.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
DEBUG_INFORMATION_FORMAT = dwarf
SWIFT_OPTIMIZATION_LEVEL = -Onone
