// Release build settings.
#include "Secrets.xcconfig"

// Build number. The real value lives in BuildNumber.xcconfig (gitignored), regenerated by
// scripts/set-build-number.sh from the git commit count. The literal below is only a fallback
// for a fresh clone that hasn't run the script yet; the optional include overrides it.
// Archiving without running that script ships build 1 and will collide on the second upload
// of a version — the preBuildScript in project.yml warns when that happens.
CURRENT_PROJECT_VERSION = 1
#include? "BuildNumber.xcconfig"

SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
VALIDATE_PRODUCT = YES
