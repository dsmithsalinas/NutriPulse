# Copy this file to .env.status-report and fill in the five private values.
# The real file is gitignored and must never be committed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HEALTHCHECK_EMAIL=
HEALTHCHECK_PASSWORD=

# Optional. Defaults to America/Los_Angeles.
REPORT_TZ=America/Los_Angeles
