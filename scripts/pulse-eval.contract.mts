import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { stripTypeScriptTypes } from 'node:module';
import { runInNewContext } from 'node:vm';
import { generatePulse, selectProvider } from '../supabase/functions/_shared/pulse-provider.ts';
import { sanitizeContext, buildSystemPrompt } from '../supabase/functions/_shared/pulse-context.ts';
import { scenarios, DATASET_VERSION } from '../supabase/functions/_shared/pulse-scenarios.ts';
import { assignSides, publicRun, validateRating, costEstimate, sha256 } from './pulse-eval/review.mjs';
const outlook={observation:'Logged food has been consistent.',foodFocus:'Keep familiar meals available.',movementFocus:'Leave room for easier days.'};
const base={provider:'gpt' as const,apiKey:'test',systemPrompt:'scope',messageType:'weekly_outlook',messages:[{role:'user',content:'My week'}]};
const success={status:'completed',model:'model-snapshot',output:[{type:'function_call',name:'submit_weekly_outlook',arguments:JSON.stringify(outlook)}],usage:{input_tokens:100,output_tokens:80,input_tokens_details:{cached_tokens:20},output_tokens_details:{reasoning_tokens:30}}};
const transport=(data:any,status=200)=>async()=>new Response(JSON.stringify(data),{status});
test('server selection defaults to Claude and rejects unexpected values',()=>{assert.equal(selectProvider(),'claude');assert.equal(selectProvider('gpt'),'gpt');assert.throws(()=>selectProvider('rogue'));});
test('GPT uses forced strict function output and normalizes to existing client contract',async()=>{
 let body:any,url:any;const result=await generatePulse(base,async(u:any,opt:any)=>{url=u;body=JSON.parse(opt.body);return new Response(JSON.stringify(success));});
 assert.equal(url,'https://api.openai.com/v1/responses');assert.equal(body.store,false);assert.equal(body.tools[0].strict,true);assert.equal(body.tool_choice.name,'submit_weekly_outlook');assert.equal(body.instructions,'scope');assert.deepEqual(result.output,{outlook});assert.equal(result.metadata.returnedModel,'model-snapshot');assert.equal(result.metadata.reasoningTokens,30);
});
test('truncation, refusal, malformed output, and out-of-scope sets fail visibly',async()=>{
 for(const data of [{...success,status:'incomplete'},{...success,output:[{type:'message',content:[{type:'refusal',refusal:'No'}]}]}, {...success,output:[{type:'function_call',name:'submit_weekly_outlook',arguments:'invalid'}]}, {...success,output:[{type:'function_call',name:'submit_weekly_outlook',arguments:JSON.stringify({...outlook,movementFocus:'Do 3 sets of squats'})}]}]) await assert.rejects(()=>generatePulse(base,transport(data)));
});
test('provider errors never return provider response body or silently fall back',async()=>{let calls=0;await assert.rejects(()=>generatePulse(base,async()=>{calls++;return new Response('SECRET echoed input',{status:429});}),{message:'Provider HTTP 429'});assert.equal(calls,1);});
test('ordinary GPT and Claude replies share the existing reply contract',async()=>{
 assert.deepEqual((await generatePulse({...base,messageType:'chat'},transport({status:'completed',output:[{type:'message',content:[{type:'output_text',text:'A useful reply.'}]}]}))).output,{reply:'A useful reply.'});
 assert.deepEqual((await generatePulse({...base,provider:'claude',messageType:'chat'},transport({stop_reason:'end_turn',content:[{type:'text',text:'A useful reply.'}]}))).output,{reply:'A useful reply.'});
});
test('32 scenarios share no family across holdout and development',()=>{assert.equal(scenarios.length,32);assert.equal(new Set(scenarios.map(s=>s.id)).size,32);for(const family of new Set(scenarios.map(s=>s.family)))assert.equal(new Set(scenarios.filter(s=>s.family===family).map(s=>s.split)).size,1);for(const s of scenarios)assert.ok(buildSystemPrompt(sanitizeContext(s.context),s.messageType).length>100);});
test('blind payload strips model identities and usage until a rating exists',()=>{const results={claude:{output:{outlook},metadata:{provider:'claude',latencyMs:10}},gpt:{output:{outlook},metadata:{provider:'gpt',latencyMs:20}}};const run={id:'x',sides:assignSides(results,0)};assert.equal(run.sides.A.metadata.provider,'claude');assert.ok(!JSON.stringify(publicRun(run)).includes('claude'));assert.ok(!JSON.stringify(publicRun(run)).includes('latencyMs'));assert.equal(publicRun({...run,rating:{choice:'A'}}).sides.A.metadata.provider,'claude');assert.equal(assignSides(results,1).A.metadata.provider,'gpt');});
test('ratings require complete bounded scores; cached token costs differ by provider',()=>{assert.throws(()=>validateRating({choice:'A'}));const scores=Object.fromEntries(['A','B'].map(s=>[s,Object.fromEntries(['grounding','usefulness','voice','boundaries'].map(d=>[d,4]))]));assert.equal(validateRating({choice:'tie',scores}).choice,'tie');assert.equal(costEstimate({requestedModel:'gpt-5.6-terra',provider:'gpt',inputTokens:100,outputTokens:10,cachedInputTokens:20}),.000284);assert.equal(costEstimate({requestedModel:'unknown',inputTokens:10,outputTokens:10}),null);});
function bridge(){let calls=0;const source=readFileSync(new URL('../supabase/functions/pulse-eval/index.ts',import.meta.url),'utf8').replace(/^import .*\n/gm,'').replace('export async function','async function').split('Deno.serve(')[0];const handler=runInNewContext(stripTypeScriptTypes(source)+'\nhandleEvaluation',{scenarios,DATASET_VERSION,sanitizeContext,buildSystemPrompt,generatePulse:async()=>{calls++;return {output:{outlook}};},crypto,TextEncoder,Response,Date,Uint8Array});const secret='t'.repeat(40);const env=(key:string)=>({PULSE_EVAL_TOKEN:secret,PULSE_EVAL_EXPIRES_AT:new Date(Date.now()+60000).toISOString(),ANTHROPIC_API_KEY:'test'}[key]);return {handler,env,secret,calls:()=>calls};}
test('private bridge rejects unauthorized, arbitrary context, and mismatched prompts before spending',async()=>{const b=bridge();const post=(body:any,secret=b.secret)=>new Request('https://test',{method:'POST',headers:{Authorization:`Bearer ${secret}`},body:JSON.stringify(body)});assert.equal((await b.handler(post({},'wrong'),b.env)).status,401);assert.equal((await b.handler(post({scenarioId:scenarios[0].id,context:{}}),b.env)).status,400);assert.equal((await b.handler(post({scenarioId:scenarios[0].id,datasetVersion:DATASET_VERSION,promptHash:'bad'}),b.env)).status,409);assert.equal(b.calls(),0);});
test('private bridge runs only matching synthetic fixture and fails closed after expiry',async()=>{const b=bridge(),s=scenarios[0];const req=()=>new Request('https://test',{method:'POST',headers:{Authorization:`Bearer ${b.secret}`},body:JSON.stringify({scenarioId:s.id,datasetVersion:DATASET_VERSION,promptHash:sha256(buildSystemPrompt(sanitizeContext(s.context),s.messageType))})});assert.equal((await b.handler(req(),b.env)).status,200);assert.equal(b.calls(),1);assert.equal((await b.handler(req(),(key:string)=>key==='PULSE_EVAL_EXPIRES_AT'?'2020-01-01':b.env(key))).status,503);assert.equal(b.calls(),1);});
